# WHITELIST: ignore everything, then allow only our own source files.
# Never switch this to a normal ignore list (see AGENTS.md).
# Game files (MASK/), build output (target/) and logs (kq8-artifacts/)
# stay ignored because they are never listed below.
*
!*/

# Never descend into these, even if a pattern below would match inside them.
/MASK/
/target/
/kq8-artifacts/
/reference/
/re/

# Top-level project files
!/.gitignore
!/STATUS.md
!/AGENTS.md
!/README.md
!/MODLOG.md
!/CREDITS.md
!/Cargo.toml
!/Cargo.lock
!/rust-toolchain.toml
!/.cargo/config.toml
!/play.cmd

# Documentation
!/docs/*.md
!/docs/**/*.md

# Local-only working notes (kept on this machine, never published).
# STATUS.md, STATUS-handoff.md and MODLOG-template.md are simply not
# whitelisted above;

# Rust sources
!/crates/*/Cargo.toml
!/crates/*/src/**/*.rs
# Shaders (our own, embedded in the viewer)
!/crates/*/src/**/*.wesl
